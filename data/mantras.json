{
  "mantras": [
    { "deity": "Shiva",     "text": "ॐ नमः शिवाय।" },
    { "deity": "Vishnu",    "text": "ॐ नमो भगवते वासुदेवाय।" },
    { "deity": "Ganesha",   "text": "ॐ गं गणपतये नमः।" },
    { "deity": "Durga",     "text": "ॐ दुं दुर्गायै नमः।" },
    { "deity": "Lakshmi",   "text": "ॐ श्रीं महालक्ष्म्यै नमः।" },
    { "deity": "Hanuman",   "text": "ॐ हं हनुमते नमः।" },
    { "deity": "Krishna",   "text": "ॐ नमो भगवते श्री कृष्णाय।" },
    { "deity": "Rama",      "text": "ॐ श्री रामाय नमः।" },
    { "deity": "Saraswati", "text": "ॐ ऐं सरस्वत्यै नमः।" },
    { "deity": "Shiva",     "text": "ॐ त्र्यम्बकं यजामहे सुगन्धिं पुष्टिवर्धनम्।\nउर्वारुकमिव बन्धनान् मृत्योर्मुक्षीय माऽमृतात्॥" },
    { "deity": "Ganesha",   "text": "वक्रतुण्ड महाकाय सूर्यकोटि समप्रभ।\nनिर्विघ्नं कुरु मे देव सर्वकार्येषु सर्वदा॥" },
    { "deity": "all",       "text": "ॐ भूर् भुवः स्वः। तत् सवितुर्वरेण्यं।\nभर्गो देवस्य धीमहि। धियो यो नः प्रचोदयात्॥\n– गायत्री मंत्र" }
  ]
}
